    <string name="onboarding_title_1">Welcome to Dube Debter</string>
    <string name="onboarding_desc_1">Dube Debter is your smart digital credit notebook. Track customer tabs, unpaid items, and store credit easily with zero manual math required.</string>
    <string name="onboarding_title_2">Manage Customers &amp; Credit Tabs</string>
    <string name="onboarding_desc_2">Register your customers, open tabs for daily purchases, and add items with unit prices. Totals and customer balances update automatically.</string>
    <string name="onboarding_title_3">Dual Ethiopian &amp; Gregorian Calendar</string>
    <string name="onboarding_desc_3">Every tab and payment is automatically timestamped in both Gregorian and Ethiopian (ዓ.ም) calendars so you never lose track of dates.</string>
    <string name="onboarding_title_4">Record Payments &amp; Close Tabs</string>
    <string name="onboarding_desc_4">Record full or partial payments. Paid tabs automatically close, excess credit carries forward for future items, and full payment history is saved.</string>

